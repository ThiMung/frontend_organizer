# URL API của Laravel
VITE_API_URL=http://localhost:8000/api

# Cấu hình để upload ảnh trực tiếp lên Cloudinary từ React
VITE_CLOUDINARY_CLOUD_NAME=ten_cloud_cua_ban
VITE_CLOUDINARY_UPLOAD_PRESET=ten_preset_unsigned_cua_ban

# Giải thích cho sinh viên: 
# Preset này phải được tạo ở chế độ "Unsigned" trên Cloudinary 
# để cho phép Frontend đẩy ảnh lên mà không cần dùng Secret Key (bảo mật hơn).